{
  "name": "committrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:simulate-pay": "node scripts/dev-simulate-pay.mjs",
    "preview:simulate-pay": "node scripts/dev-simulate-pay.mjs preview",
    "build": "node scripts/generate-pwa-icons.mjs && vite build && node scripts/copy-404.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node scripts/clean.mjs",
    "audit": "node scripts/audit-all.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "audit:governance": "node scripts/audit-runner.mjs --gov",
    "audit:governance:quick": "node scripts/audit-runner.mjs --gov --quick",
    "audit:governance:full": "node scripts/audit-runner.mjs --gov --with-legacy",
    "audit:product": "node scripts/audit-runner.mjs modes insights features",
    "audit:frontend": "node scripts/audit-runner.mjs --only=frontend",
    "audit:platform": "node scripts/audit-runner.mjs --only=platform",
    "audit:summary": "node scripts/audit-summary.mjs",
    "audit:fix-deps": "npm audit fix --omit=dev",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:design": "node scripts/audit-runner.mjs design",
    "audit:styles": "node scripts/audit-styles.mjs",
    "audit:copy": "node scripts/audit-copy-tone.mjs",
    "audit:copy:list": "node scripts/audit-copy-tone.mjs --list",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:i18n:fallback": "node scripts/audit-i18n-fallback.mjs --list",
    "audit:i18n:hardcoded": "node scripts/audit-i18n-hardcoded.mjs --list",
    "i18n:translate:fast": "node scripts/translate-fallback-locales.mjs",
    "sync:i18n": "node scripts/sync-i18n-keys.mjs",
    "i18n:repair": "node scripts/i18n-repair-corruption.mjs && node scripts/i18n-repair-placeholders.mjs",
    "i18n:translate": "node scripts/i18n-auto-translate.mjs",
    "i18n:translate:all": "node scripts/translate-fallback-locales.mjs",
    "audit:features": "node scripts/audit-runner.mjs features",
    "audit:modes": "node scripts/audit-runner.mjs modes",
    "audit:sync": "node scripts/audit-runner.mjs sync",
    "audit:guidance": "node scripts/audit-runner.mjs guidance",
    "audit:tree": "node scripts/governance/tree.mjs",
    "audit:insights": "node scripts/audit-runner.mjs insights",
    "audit:performance": "node scripts/audit-runner.mjs performance",
    "audit:mobile": "node scripts/audit-runner.mjs mobile",
    "audit:charts": "node scripts/audit-runner.mjs duplicates",
    "audit:duplicates": "node scripts/audit-runner.mjs duplicates",
    "audit:dead-code": "node scripts/audit-ui-depth.mjs --list",
    "audit:code": "node scripts/audit-code.mjs",
    "audit:dependencies": "node scripts/audit-runner.mjs features architecture",
    "audit:architecture": "node scripts/audit-runner.mjs architecture",
    "audit:ui-depth": "node scripts/audit-ui-depth.mjs --list",
    "audit:ui-inventory": "node scripts/audit-ui-depth.mjs --inventory",
    "audit:merge": "node scripts/audit-merge-suggestions.mjs --list",
    "audit:list": "node scripts/audit-runner.mjs --list",
    "audit:report": "node scripts/audit-dev-report.mjs",
    "audit:report:full": "node scripts/audit-dev-report.mjs --full",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sync": "vitest run src/storage/__tests__ src/services/sync/__tests__",
    "test:engines": "vitest run src/engines",
    "test:utils": "vitest run src/utils/__tests__",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "git:ship": "node scripts/git-commit-push.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.106.2",
    "date-fns": "^4.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "knip": "^5.88.1",
    "pdfkit": "^0.18.0",
    "postcss": "^8.5.13",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
