{
  "name": "perovo",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:simulate-pay": "node scripts/dev-simulate-pay.mjs",
    "preview:simulate-pay": "node scripts/dev-simulate-pay.mjs preview",
    "build": "node scripts/generate-app-version.mjs && node scripts/vite-build-pages.mjs && node scripts/build-ota-bundle.mjs && node scripts/copy-404.mjs",
    "capture:landing-screens": "node scripts/capture-landing-screens.mjs",
    "generate:android-icons": "node scripts/generate-android-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node scripts/clean.mjs",
    "audit": "node scripts/audit-all.mjs --strict",
    "audit:relaxed": "node scripts/audit-all.mjs",
    "audit:gov": "node scripts/audit-runner.mjs --gov",
    "audit:gov:quick": "node scripts/audit-runner.mjs --gov --quick",
    "audit:fix": "node scripts/audit-fix.mjs",
    "audit:fix:apply": "node scripts/audit-fix.mjs --apply",
    "audit:fix:buttons": "node scripts/fix-buttons.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:apis": "node scripts/audit-apis.mjs",
    "audit:docs-sync": "node scripts/audit-docs-sync.mjs",
    "roger:all": "node scripts/roger-all.mjs",
    "roger:relaxed": "node scripts/roger-all.mjs",
    "i18n:translate:fast": "node scripts/translate-fallback-locales.mjs",
    "sync:i18n": "node scripts/sync-i18n-keys.mjs",
    "i18n:repair": "node scripts/i18n-repair-corruption.mjs && node scripts/i18n-repair-placeholders.mjs",
    "i18n:translate": "node scripts/i18n-auto-translate.mjs",
    "i18n:fix": "node scripts/i18n-fix-free.mjs",
    "i18n:fix:api": "node scripts/i18n-fix-free.mjs --api",
    "i18n:fix:paid": "node scripts/i18n-fix-financial-terms.mjs",
    "verify:razorpay": "node scripts/verify-razorpay.mjs",
    "i18n:translate:all": "node scripts/translate-fallback-locales.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "qa": "node tests/qa-runner.mjs",
    "qa:fast": "node tests/qa-runner.mjs --fast",
    "qa:p0": "node tests/qa-runner.mjs --p0",
    "test:sync": "vitest run tests/suites/07-architecture.test.mjs",
    "test:engines": "vitest run tests/suites/01-fintech-logic.test.mjs tests/suites/03-edge-cases.test.mjs",
    "test:utils": "vitest run tests/suites/02-security-tiers.test.mjs tests/suites/04-state-machine.test.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "ship": "node scripts/git-ship.mjs",
    "git:ship": "node scripts/git-ship.mjs",
    "gh:login": "node scripts/gh-auth-login.mjs",
    "site:mode": "node scripts/site-customer-mode.mjs",
    "site:customer-on": "node scripts/site-customer-mode.mjs on",
    "site:customer-off": "node scripts/site-customer-mode.mjs off",
    "cap:sync": "npm run build && npx cap sync && node scripts/patch-android-manifest.mjs && node scripts/patch-ios-info-plist.mjs",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "apk:dev": "node scripts/build-dev-apk.mjs",
    "apk:patch-version": "node scripts/patch-android-version.mjs",
    "apk:twa": "cd twa && bubblewrap build --manifest twa-manifest.json",
    "apk:twa:install": "cd twa && bubblewrap install",
    "zip": "node scripts/zip.mjs",
    "secrets:fcm": "node scripts/set-fcm-secret.mjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^7.0.1",
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.2",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-updater": "^7.45.10",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.106.2",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.15.0",
    "fuse.js": "^7.4.2",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.3.11",
    "posthog-js": "^1.386.6",
    "react": "^19.2.5",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.5",
    "react-is": "18.3.1",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "archiver": "^5.3.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "knip": "^5.88.1",
    "pdfkit": "^0.18.0",
    "postcss": "^8.5.13",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^8.0.10",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vitest": "^4.1.9"
  }
}
