# Full URL from Supabase → Settings → API (not just the project ref)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay — use test keys from dashboard.razorpay.com → Settings → API Keys
# Restart `npm run dev` after changing .env
VITE_RAZORPAY_KEY_ID=rzp_test_xxxx

# Supabase Edge Function secrets (Dashboard → Edge Functions → razorpay-checkout → Secrets)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=your_test_secret

# Live app URL for Profile → Update app (defaults to GitHub Pages project site).
# VITE_UPDATE_SERVER_URL=https://your-user.github.io/PROJECTapp/
# VITE_APK_DOWNLOAD_URL=https://github.com/you/PROJECTapp/releases/latest/download/Perovo-dev-latest.apk

# Localhost only — show landing page instead of full app in `npm run dev`
# npm run site:customer-on  → sets VITE_CUSTOMER_MODE=1 in .env.local (restart dev server)
# VITE_CUSTOMER_MODE=1

# Leegality Aadhaar eSign — sandbox keys from leegality.com dashboard
VITE_LEEGALITY_BASE_URL=https://sandbox.leegality.com
VITE_LEEGALITY_API_TOKEN=

# Surepass KYC (PAN + bank verify) — free trial at surepass.io
VITE_SUREPASS_TOKEN=

# Gold price auto-update — free tier at goldapi.io (100 calls/month)
VITE_GOLD_API_KEY=

# Claude translation scripts (npm run i18n:translate / i18n:fix) — put real key in .env only, never commit
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Sentry error tracking — set DSN in .env; add VITE_SENTRY_ENABLE_DEV=1 to test in dev
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLE_DEV=

# PostHog product analytics (production only)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Firebase Cloud Messaging — Console → Project settings → General (web app) + Cloud Messaging (VAPID)
# Service worker copy: public/firebase-messaging-sw.js (cannot read .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Google Cloud Vision — bill OCR (free tier ~1k/month). Tesseract used offline when unset.
VITE_GOOGLE_VISION_KEY=

# Setu Account Aggregator — sandbox at setu.co
VITE_SETU_AA_CLIENT_ID=
VITE_SETU_AA_CLIENT_SECRET=
VITE_SETU_AA_PRODUCT_INSTANCE_ID=

# Setu BBPS — bill fetch + pay
VITE_SETU_BBPS_CLIENT_ID=
VITE_SETU_BBPS_CLIENT_SECRET=
VITE_SETU_BBPS_PRODUCT_INSTANCE_ID=

# Stream.io family chat — getstream.io dashboard
VITE_STREAM_API_KEY=
# Supabase Edge Function secret (stream-token): STREAM_API_SECRET
