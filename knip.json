{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/capgo-notify-only.js",
    "src/capgo-notify-update-test-only.js",
    "src/main.jsx",
    "src/main-update-test.jsx",
    "public/notification-handler.js",
    "src/**/*.test.js",
    "tests/**/*.test.mjs"
  ],
  "project": ["src/**/*.{js,jsx}", "public/notification-handler.js", "tests/**/*.test.mjs"],
  "ignore": [
    "scripts/**",
    "dist/**",
    "src/governance/**"
  ],
  "ignoreDependencies": ["sharp", "pdfkit", "gh-pages", "@capacitor/ios"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/engines/**": ["exports"],
    "src/utils/**": ["exports"],
    "src/services/**": ["exports"],
    "src/ui/primitives/**": ["exports", "duplicates"],
    "src/ui/patterns/**": ["exports", "duplicates"],
    "src/ui/features/**": ["exports", "duplicates"],
    "src/ui/layout/**": ["exports", "duplicates"],
    "src/constants/userModes.js": ["duplicates"],
    "src/constants/modeExperience.js": ["exports"],
    "src/guidance/**": ["exports"],
    "src/ui/guidance/**": ["exports", "duplicates"],
    "src/ui/icons/**": ["duplicates"]
  }
}
