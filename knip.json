{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.jsx", "public/notification-handler.js"],
  "project": ["src/**/*.{js,jsx}", "public/notification-handler.js"],
  "ignore": [
    "scripts/**",
    "dist/**",
    "src/engines/__tests__/**",
    "src/utils/__tests__/**",
    "src/governance/**"
  ],
  "ignoreDependencies": ["sharp", "pdfkit", "gh-pages"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/engines/**": ["exports"],
    "src/utils/**": ["exports"],
    "src/services/**": ["exports"],
    "src/ui/primitives/**": ["exports", "duplicates"],
    "src/ui/patterns/**": ["exports", "duplicates"],
    "src/ui/features/**": ["exports", "duplicates"],
    "src/ui/layout/**": ["exports", "duplicates"],
    "src/constants/userModes.js": ["duplicates"],
    "src/constants/modeExperience.js": ["exports"],
    "src/guidance/**": ["exports"],
    "src/ui/guidance/**": ["exports", "duplicates"],
    "src/ui/icons/**": ["duplicates"]
  }
}
